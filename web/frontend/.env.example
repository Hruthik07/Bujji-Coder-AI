# Frontend runtime configuration.
#
# In local development, leave both blank — CRA's package.json "proxy"
# setting forwards relative /api/* fetches to localhost:8010, and the
# WS_URL default points at ws://<hostname>:8010 which also works.
#
# In production (Vercel), set these to the deployed Railway backend.

# REST API base URL (no trailing slash)
REACT_APP_API_URL=https://your-backend.up.railway.app

# WebSocket base URL — must use wss:// scheme when the API_URL is https://
REACT_APP_WS_URL=wss://your-backend.up.railway.app
